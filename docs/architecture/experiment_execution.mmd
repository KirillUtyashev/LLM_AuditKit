---
config:
  theme: mc
---
classDiagram
    class ExperimentConfig {
        +experiment_id: str
        +dataset_schema: ExperimentDatasetSchema
        +personas: List~Persona~
        +inference: InferenceConfig
        +save_after_each_batch: bool
    }
    class ExperimentDatasetSchema {
        +scenario_id_column: str
        +job_posting_column: str
        +resume_columns: List~str~
        +context_columns: Dict~str, str~
    }
    class Persona {
        +id: str
        +name: str
        +description: str
    }
    class InferenceConfig {
        <<shared inference>>
        +batch_size: int
    }
    class InferenceRequest {
        <<shared inference>>
    }
    class InferenceBatchPreview {
        <<shared inference>>
    }
    class InferenceBatchResult {
        <<shared inference>>
    }
    class InferenceResult {
        <<shared inference>>
    }
    class InferenceOrchestrator {
        <<shared inference>>
    }
    class ExperimentJobKey {
        +experiment_id: str
        +scenario_id: str
        +persona_id: str
        +model_config_id: str
    }
    class ExperimentOutcome {
        +picks: List~int~
        +logprobs: List~float~
        +generated_response: str
        +comment: Optional~str~
    }
    class ExperimentOutputRecord {
        +key: ExperimentJobKey
        +request_id: str
        +outcome: Optional~ExperimentOutcome~
        +error_type: Optional~str~
        +error_message: Optional~str~
    }
    class ExperimentRunner {
        -inference_orchestrator: InferenceOrchestrator
        -result_store: ExperimentResultStore
        +preview(dataset: DataFrame, config: ExperimentConfig, batch_number: int) InferenceBatchPreview
        +run(dataset: DataFrame, config: ExperimentConfig) DataFrame
        +run_async(dataset: DataFrame, config: ExperimentConfig) DataFrame
        -build_requests(dataset: DataFrame, config: ExperimentConfig) List~InferenceRequest~
        -build_prompt(row: Series, config: ExperimentConfig) str
        -parse_result(result: InferenceResult, config: ExperimentConfig) ExperimentOutcome
    }
    class ExperimentResultStore {
        -output_path: Path
        +initialize(dataset: DataFrame, config: ExperimentConfig) DataFrame
        +save_batch(output_dataset: DataFrame, records: List~ExperimentOutputRecord~) void
        +is_complete(output_dataset: DataFrame, key: ExperimentJobKey) bool
    }
    class DataFrame {
        <<pandas>>
    }
    ExperimentConfig --> Persona
    ExperimentConfig --> ExperimentDatasetSchema
    ExperimentConfig --> InferenceConfig
    ExperimentRunner --> ExperimentConfig
    ExperimentRunner --> ExperimentJobKey : derives request identity
    ExperimentRunner --> InferenceRequest : builds pending requests
    ExperimentRunner --> InferenceBatchPreview : previews
    ExperimentRunner --> InferenceOrchestrator : consumes batches
    InferenceOrchestrator --> InferenceBatchResult : yields sequentially
    InferenceBatchResult --> InferenceResult
    ExperimentRunner --> ExperimentOutcome : parses
    ExperimentRunner --> ExperimentOutputRecord : builds
    ExperimentRunner --> ExperimentResultStore : checkpoints completed batches
    ExperimentRunner --> DataFrame : processes
    ExperimentResultStore --> ExperimentJobKey : indexes by
    ExperimentResultStore --> ExperimentOutputRecord : stores
    ExperimentResultStore --> DataFrame : updates and persists
