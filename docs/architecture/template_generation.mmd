---
config:
  theme: mc
---
classDiagram
    class TemplateGenerationConfig {
        +templates_per_job_posting: int
        +skills: SkillConfig
        +work_experiences: int
        +student_experiences: int
        +education: EducationConfig
        +inference: InferenceConfig
        +model_config_id: str
        +save_after_each_result: bool
    }
    class SkillConfig {
        +sections: List~SkillSection~
    }
    class SkillSection {
        +type: str
        +count: int
    }
    class EducationConfig {
        +degrees: List~str~
    }
    class TemplateGenerator {
        -inference_orchestrator: InferenceOrchestrator
        -template_store: TemplateStore
        +preview(dataset: DataFrame, config: TemplateGenerationConfig, batch_number: int) InferenceBatchPreview
        +generate(dataset: DataFrame, config: TemplateGenerationConfig) DataFrame
        +generate_async(dataset: DataFrame, config: TemplateGenerationConfig) DataFrame
        -build_requests(dataset: DataFrame, config: TemplateGenerationConfig) List~InferenceRequest~
        -build_prompt(row: Series, config: TemplateGenerationConfig) str
        -parse_result(result: InferenceResult, config: TemplateGenerationConfig) List~Template~
    }
    class TemplateStore {
        -output_path: Path
        +initialize(dataset: DataFrame, templates_per_row: int) DataFrame
        +save_row(output_dataset: DataFrame, scenario_id: str, templates: List~Template~) void
        +save_error(output_dataset: DataFrame, scenario_id: str, error: str) void
        +is_complete(output_dataset: DataFrame, scenario_id: str) bool
    }
    class Template {
        +content: str
    }
    class InferenceConfig {
        <<shared inference>>
        +batch_size: int
    }
    class InferenceRequest {
        <<shared inference>>
    }
    class InferenceBatchPreview {
        <<shared inference>>
    }
    class InferenceBatchResult {
        <<shared inference>>
    }
    class InferenceResult {
        <<shared inference>>
    }
    class InferenceOrchestrator {
        <<shared inference>>
    }
    class DataFrame {
        <<pandas>>
    }
    TemplateGenerationConfig --> SkillConfig
    SkillConfig --> SkillSection
    TemplateGenerationConfig --> EducationConfig
    TemplateGenerationConfig --> InferenceConfig
    TemplateGenerator --> InferenceRequest : builds pending requests
    TemplateGenerator --> InferenceBatchPreview : previews
    TemplateGenerator --> InferenceOrchestrator : consumes batches
    InferenceOrchestrator --> InferenceBatchResult : yields sequentially
    InferenceBatchResult --> InferenceResult
    TemplateGenerator --> TemplateGenerationConfig : uses
    TemplateGenerator --> TemplateStore : checkpoints results
    TemplateGenerator --> DataFrame : processes
    TemplateGenerator --> Template : parses
    TemplateStore --> DataFrame : updates and persists
