---
config:
  theme: mc
---
classDiagram
    class DatasetSource {
        <<protocol>>
        +load() DataFrame
    }
    class LocalDatasetSource {
        -path: Path
        -file_format: Optional~str~
        +load() DataFrame
    }
    class DatasetSchema {
        +required_columns: List~str~
        +nonempty_columns: List~str~
        +optional_columns: Dict~str, str~
    }
    class DatasetLoader {
        -schema: DatasetSchema
        -validator: DatasetValidator
        +load(source: DatasetSource) DataFrame
    }
    class DatasetValidator {
        -schema: DatasetSchema
        +validate(dataset: DataFrame) void
    }
    class ScenarioIdentity {
        +build_scenario_id(row: Mapping) str
        +derive_scenario_ids(dataset: DataFrame) List~str~
    }
    class DataFrame {
        <<pandas>>
    }
    DatasetSource <|.. LocalDatasetSource
    LocalDatasetSource --> DataFrame : reads raw table
    DatasetLoader --> DatasetSource : loads
    DatasetLoader --> ScenarioIdentity : establishes IDs
    DatasetLoader --> DatasetValidator : validates
    DatasetValidator --> DatasetSchema
    DatasetLoader --> DataFrame : returns normalized
